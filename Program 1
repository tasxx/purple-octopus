        int start = scanner.nextInt();
        System.out.print("What number should we end at? ");
        int end = scanner.nextInt();
        System.out.println("\nTimes table for " + timesTable + ":");
        System.out.println("--------------------------------");
        for (int i = start; i <= end; i++) {
            int result = timesTable * i;
            System.out.println(timesTable + " × " + i + " = " + result);
