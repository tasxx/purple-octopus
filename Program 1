    public void setupGrid () {
        String board[][] = new String[3][3];
        String currentPlayer = "X";
        int moves = 0;
        while (moves < 9) {
            printBoard(board);
            System.out.println(currentPlayer + "'s turn");
            System.out.print("Enter row (1-3): ");
            int row = scanner.nextInt() - 1;
            System.out.print("Enter column (1-3): ");
            int col = scanner.nextInt() - 1;


            if (!(row >= 0 && row <= 2 && col >= 0 && col <= 2)) {
                System.out.println("Invalid move! Try again.");
                continue;
            }
            if (board[row][col] != null) {
                System.out.println("Position already taken! Try again.");
                continue;
            }

            board[row][col] = currentPlayer;
            moves++;

            if (checkWin(board, currentPlayer)) {
                printBoard(board);
                System.out.println(currentPlayer + " wins!");
                break;
            }

            if (moves == 9) {
                printBoard(board);
                System.out.println("\nIt's a tie!");
                break;
            }
                currentPlayer = currentPlayer.equals("X") ? "O" : "X";
            }
        }


    public boolean checkWin(String[][] board, String player) {
        for (int i = 0; i < 3; i++) {
            if (player.equals(board[i][0]) && player.equals(board[i][1]) && player.equals(board[i][2])) {
                return true;
            }
        }
        for (int i = 0; i<3; i++) {
            if (player.equals(board[i][0]) && player.equals(board[i][1]) && player.equals(board[i][2])) {
                return true;
            }
        }
        if (player.equals(board[0][0]) && player.equals(board[1][1]) && player.equals(board[2][2])) {
            return true;
        }
        if (player.equals(board[0][2]) && player.equals(board[1][1]) && player.equals(board[2][0])) {
            return true;
        }


        return false;

    }




