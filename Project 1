package io.github.some_example_name;

import com.badlogic.gdx.ApplicationAdapter;
import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;
import com.badlogic.gdx.utils.ScreenUtils;
import com.badlogic.gdx.Input;

/** {@link com.badlogic.gdx.ApplicationListener} implementation shared by all platforms. */
public class Pong extends ApplicationAdapter {
    ShapeRenderer sr;




    private float cirX = 30;
    private float cirY = 30;
    private float cirR = 20;
    private float cirWidth = cirR;
    private float cirHeight = cirR;
    private float velocityX = 200;
    private float velocityY = 200;


    private float rectX = 50;
    private float rectY = 200;
    private float rectWidth = 25;
    private float rectHeight = 100;
    private float velocity1X = 200;
    private float velocity1Y = 200;


    private float rect2X = 615;
    private float rect2Y = 200;
    private float rect2Width = 25;
    private float rect2Height = 100;
    private float velocity2X = 200;
    private float velocity2Y = 200;



    @Override
    public void create() {
        sr = new ShapeRenderer();
    }



    @Override
    public void render() {
        ScreenUtils.clear(0.25f, 0.15f, 0.5f, 1f);
        float deltaTime = Gdx.graphics.getDeltaTime();
        cirX += velocityX * deltaTime;
        if (cirX <= 0) {
            cirX = 0;
            velocityX = Math.abs(velocityX);
        } else if (cirX + cirWidth >= Gdx.graphics.getWidth() ) {
            cirX = Gdx.graphics.getWidth() - cirR;
            velocityX = -Math.abs(velocityX);
        }

        cirY += velocityY * deltaTime;
        if (cirY <= 0) {
            cirY = 0;
            velocityY = Math.abs(velocityY);
        } else if (cirY + cirHeight >= Gdx.graphics.getHeight() ) {
            cirY = Gdx.graphics.getHeight() - cirR;
            velocityY = -Math.abs(velocityY);
        }


        cirY += velocityY * deltaTime;
        cirX += velocityX * deltaTime;
        if (cirX < rectX + rectWidth) {
            cirX = rectWidth + velocity1X * deltaTime;
            velocityX = Math.abs(velocityX);
        } else if (cirX + rectWidth >= Gdx.graphics.getWidth() ) {
            cirX = Gdx.graphics.getWidth() - cirR;
            velocityX = -Math.abs(velocityX);
        }





//-------------------------------------------------------------------------------------------

        if (rectY <= 0) {
            rectY = 0;
            velocity1Y = Math.abs(velocity1Y);
        } else if (rectY + rectHeight >= Gdx.graphics.getHeight() ) {
            rectY = Gdx.graphics.getHeight() - rectHeight;
            velocity1Y = -Math.abs(velocity1Y);
        }


        if (rect2Y <= 0) {
            rect2Y = 0;
            velocity2Y = Math.abs(velocity2Y);
        } else if (rect2Y + rect2Height >= Gdx.graphics.getHeight() ) {
            rect2Y = Gdx.graphics.getHeight() - rect2Height;
            velocity2Y = -Math.abs(velocity2Y);
        }








        sr.begin(ShapeRenderer.ShapeType.Filled);
            sr.setColor(Color.RED);
            sr.circle(cirX, cirY, cirR);
            sr.setColor(Color.WHITE);
            sr.rect(rectX, rectY, rectWidth, rectHeight);
            sr.rect(rect2X, rect2Y, rect2Width, rect2Height);
        if (Gdx.input.isKeyPressed(Input.Keys.DOWN)) {
            rect2Y = rect2Y + -10;
            sr.rect(rect2X, rect2Y, rect2Width, rect2Height);
            }
        if (Gdx.input.isKeyPressed(Input.Keys.UP)){
            rect2Y = rect2Y + 10;
            sr.rect(rect2X, rect2Y, rect2Width, rect2Height);
            }
        if  (Gdx.input.isKeyPressed(Input.Keys.S)) {
            rectY = rectY + -10;
            sr.rect(rectX, rectY, rectWidth, rectHeight);
            }
        if  (Gdx.input.isKeyPressed(Input.Keys.W)) {
            rectY = rectY + 10;
            sr.rect(rectX, rectY, rectWidth, rectHeight);
        }
        sr.end();




    }



}

























MAIN CLASS
package io.github.some_example_name;

import com.badlogic.gdx.ApplicationAdapter;
import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;
import com.badlogic.gdx.utils.ScreenUtils;

import java.util.ArrayList;
import java.util.List;

/** {@link com.badlogic.gdx.ApplicationListener} implementation shared by all platforms. */
public class Main extends ApplicationAdapter {
    ShapeRenderer shape;
    Ball ball;
    List<Brick> bricks = new ArrayList<>();


    @Override
    public void create() {
        shape = new ShapeRenderer();
        ball = new Ball(10, 10, 25, 25);
        float brickWidth = 75f;
        float brickHeight = 30f;
        float startX = 10f;
        float startY = Gdx.graphics.getHeight() - brickHeight - 10f; // Near top
        float spacing = brickWidth + 15f;
        for (int i = 0; i < 5; i++) {
            float brickX = startX + i * spacing;
            bricks.add(new Brick(brickX, startY, brickWidth, brickHeight, Color.WHITE));
        }
    }

    @Override
    public void render() {
        ScreenUtils.clear(0.15f, 0.15f, 0.2f, 1);
        ball.update(Gdx.graphics.getDeltaTime());
        shape.begin(ShapeRenderer.ShapeType.Filled);
        ball.draw(shape);
        for (Brick brick : bricks) {
            brick.draw(shape);
        }
        shape.end();
    }



    @Override
    public void dispose() {
        shape.dispose();
    }
}




























BALL CLASS
package io.github.some_example_name;

import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;

public class Ball {
    private float x;
    private float y;
    private float width;
    private float height;
    private Color col;
    private float velocityX = 200f;
    private float velocityY = 200f;

    public Ball(float x, float y, float width, float height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.col = new Color(Color.RED);
    }

    public float getX() {
        return x;
    }

    public float getY() {
        return y;
    }

    public float getWidth() {
        return width;
    }

    public float getHeight() {
        return height;
    }

    public Color getCol() {
        return col;
    }

    public void setX(float x) {
        this.x = x;
    }

    public void setY(float y) {
        this.y = y;
    }


    public void update(float delta) {
        x += velocityX * delta;
        y += velocityY * delta;


        if (x <= 0) {
            x = 0;
            velocityX = Math.abs(velocityX);
        } else if (x + width >= Gdx.graphics.getWidth()) {
            x = Gdx.graphics.getWidth() - width;
            velocityX = -Math.abs(velocityX);
        }

        if (y <= 0) {
            y = 0;
            velocityY = Math.abs(velocityY);
        } else if (y + height >= Gdx.graphics.getHeight()) {
            y = Gdx.graphics.getHeight() - height;
            velocityY = -Math.abs(velocityY);
        }
    }


    public void draw(ShapeRenderer shape) {
        shape.setColor(col);
        shape.rect(x, y, width, height);
    }
}

































BRICK CLASS
package io.github.some_example_name;

import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;

public class Brick {
    private float x;
    private float y;
    private float width;
    private float height;
    private Color color;

    public Brick(float x, float y, float width, float height, Color color) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.color = color;
    }

    public void draw(ShapeRenderer shape) {
        shape.setColor(color);
        shape.rect(x, y, width, height);
    }
}







