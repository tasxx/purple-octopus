BALL CLASS
package io.github.some_example_name;

import com.badlogic.gdx.Gdx;
import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;

public class Ball {
    private int x;
    private int y;
    private int width;
    private int height;
    private Color col;
    private int velocityX = 400;
    int velocityY = 400;

    public Ball(int x, int y, int width, int height) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        this.col = new Color(Color.RED);
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public int getWidth() {
        return width;
    }

    public int getHeight() {
        return height;
    }

    public Color getCol() {
        return col;
    }

    public void setX(float x) {
        this.x = (int) x;
    }

    public void setY(float y) {
        this.y = (int) y;
    }


    public void update(float delta) {
        x += velocityX * delta;
        y += velocityY * delta;


        if (x <= 0) {
            x = 0;
            velocityX = Math.abs(velocityX);
        } else if (x + width >= Gdx.graphics.getWidth()) {
            x = Gdx.graphics.getWidth() - width;
            velocityX = -Math.abs(velocityX);
        }

        if (y <= 0) {
            y = 0;
            velocityY = Math.abs(velocityY);
        } else if (y + height >= Gdx.graphics.getHeight()) {
            y = Gdx.graphics.getHeight() - height;
            velocityY = -Math.abs(velocityY);
        }


    }


    public void draw(ShapeRenderer shape) {
        shape.setColor(col);
        shape.rect(x, y, width, height);
    }
}


































BRICK CLASS
package io.github.some_example_name;

import com.badlogic.gdx.graphics.Color;
import com.badlogic.gdx.graphics.glutils.ShapeRenderer;

public class Brick {
    boolean destroyed;
    private int x;
    private int y;
    private int width;
    private int height;
    private Color col;


    public Brick(int x, int y, int width, int height, Color c) {
        this.x = x;
        this.y = y;
        this.width = width;
        this.height = height;
        col = c;
        destroyed = false;
    }

    public void setColor(Color color) {
        col = color;
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public int getWidth() {
        return width;
    }

    public int getHeight() {
        return height;
    }



    public boolean isDestroyed() {
        return destroyed;
    }


    public void setDestroyed(boolean destroyed) {
        this.destroyed = destroyed;

        if (this.destroyed == true) {
            dispose();
            x = -1000;
            y = -1000;
        }
    }


    public void draw(ShapeRenderer shape) {
        shape.setColor(col);
        shape.rect(x, y, width, height);
    }




    private void dispose() {

    }


}

























